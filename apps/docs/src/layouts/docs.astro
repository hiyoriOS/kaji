---
import DocPagination from "@/components/navigation/pagination.astro";
import Footer from "@/components/site/footer.astro";
import Base from "@/layouts/base.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  activeHref: string;
  headings: Heading[];
  sourcePath: string;
}

const { title, description, activeHref, headings, sourcePath } = Astro.props;
const plainDescription = description.replaceAll("`", "");
const slug = activeHref === "/docs" ? undefined : activeHref.slice("/docs/".length);
const markdownHref =
  slug === undefined ? "/llms.mdx/docs/content.md" : `/llms.mdx/docs/${slug}/content.md`;
const editHref = `https://github.com/enkyuan/kaji/blob/main/apps/docs/content/${sourcePath}`;
---

<Base title={title} description={plainDescription} activeHref={activeHref} headings={headings}>
  <article class="article doc-article">
    <header>
      <h1>{title}</h1>
      <p class="tagline">
        {description.split("`").map((segment, index) =>
          index % 2 === 1 ? <code>{segment}</code> : segment,
        )}
      </p>
      <div class="doc-actions">
        <a href={markdownHref} data-astro-reload>Markdown</a>
        <span aria-hidden="true">·</span>
        <a href={editHref}>Edit on GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.npmjs.com/package/@hiyori/kaji" target="_blank" rel="noopener noreferrer">npm</a>
      </div>
    </header>

    <div class="doc-content">
      <slot />
    </div>

    <DocPagination currentHref={activeHref} />
  </article>
  <Footer />
</Base>
