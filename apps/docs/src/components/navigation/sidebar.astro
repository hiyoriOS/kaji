---
import KajiWordmark from "@/components/site/nav-wordmark.astro";
import { navigation } from "@/data/navigation";
import { Github } from "reicon-brands";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  activeHref: string;
  headings?: Heading[];
}

const { activeHref: currentHref, headings = [] } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const tocLabel = (heading: Heading) => heading.text;
const githubIcon = Github.toSvg({
  size: 12,
  className: "nav-github-icon",
}).replace(' role="img"', ' aria-hidden="true" focusable="false"');
---

<nav class="side-nav" aria-label="Documentation">
  <KajiWordmark current={currentHref === "/"} />

  <div class="nav-links">
    {
      navigation.map((section) => (
        <>
          {section.label && <div class="nav-section">{section.label}</div>}
          {section.items.map((item) => {
            const isActive = currentHref === item.href;

            return (
              <div class="nav-item-wrapper">
                {isActive ? (
                  <span class="nav-link active" aria-current="page">
                    {item.label}
                    {item.status === "wip" && (
                      <sup class="nav-wip" aria-label="work in progress">
                        WIP
                      </sup>
                    )}
                  </span>
                ) : (
                  <a class="nav-link" href={item.href}>
                    {item.label}
                    {item.status === "wip" && (
                      <sup class="nav-wip" aria-label="work in progress">
                        WIP
                      </sup>
                    )}
                  </a>
                )}

                {isActive && tableOfContents.length > 0 && (
                  <ol class="nav-toc" data-toc-list>
                    {tableOfContents.map((heading) => (
                      <li data-toc-item data-level={heading.depth}>
                        <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                          {tocLabel(heading)}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            );
          })}
        </>
      ))
    }
  </div>

  <div class="nav-meta">
    <span class="nav-version">v0</span>
    <span class="nav-dot" aria-hidden="true">·</span>
    <a
      class="nav-github"
      href="https://github.com/hiyoriOS/kaji"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Kaji on GitHub"
    >
      <Fragment set:html={githubIcon} />
    </a>
  </div>
</nav>
