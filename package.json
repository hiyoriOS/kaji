{
  "name": "kaji",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": ["apps/*", "packages/*", "examples/*"],
  "scripts": {
    "dev": "bun --filter=@kaji/docs dev",
    "build": "bun --filter='*' run build",
    "typecheck": "bun --filter='*' run typecheck",
    "lint": "bun --filter='*' run lint",
    "format": "bun --filter='*' run format",
    "format:check": "bun --filter='*' run format:check",
    "test": "bun --filter=@hiyorios/kaji run test",
    "readme:check": "cmp -s README.md packages/ts/README.md || (echo 'README drift: copy README.md to packages/ts/README.md' >&2; exit 1)",
    "package:check": "bun run readme:check && bun --filter=@hiyorios/kaji run package:check",
    "package:smoke": "bun --filter=@hiyorios/kaji run package:smoke",
    "example:refund": "bun --filter=@hiyorios/kaji-example-refund run start"
  }
}
